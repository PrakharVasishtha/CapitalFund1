# CapitalFund1 Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env with real secrets!

# === Email Alert Configuration ===
# Gmail address for sending email alerts
ALERT_EMAIL_USER=your-gmail@gmail.com
# Gmail App Password (use App Password, not your regular password)
ALERT_EMAIL_PASS=your-gmail-app-password

# === Telegram Bot Configuration ===
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234GHIK-cyzyxZ4S
# Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# === CapitalFund Users Configuration ===
# JSON array of user objects with all necessary credentials
# Format: 
# CAPITALFUND_USERS='[{
#     "uci": "1",
#     "name": "User Name",
#     "broker_client_id": "CLIENT_ID",
#     "password_broker": "BROKER_PASSWORD",
#     "topt_broker": "TOTP_SECRET",
#     "email_user": "user@gmail.com",
#     "email_password": "user-gmail-app-password",
#     "bank_user": "BANK_ACCOUNT",
#     "bank_password": "BANK_PASSWORD",
#     "intraday": "0",
#     "PAN": "PAN_NUMBER"
# }]'"